<UserControl x:Class="SoundManager.Windows.SourceListView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style x:Key="MuteSwitch" TargetType="CheckBox">
   <Setter Property="Foreground" Value="#EDF3FF"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="CheckBox">
      <StackPanel Orientation="Horizontal" Margin="8,6">
       <TextBlock x:Name="Speaker" Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBlock Text="음소거" VerticalAlignment="Center" Margin="0,0,8,0"/>
       <Border x:Name="Track" Background="#3B495E" CornerRadius="12" Width="40" Height="24">
        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#EDF3FF" HorizontalAlignment="Left" Margin="3"/>
       </Border>
      </StackPanel>
      <ControlTemplate.Triggers>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Track" Property="Background" Value="#35746B"/>
        <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
        <Setter TargetName="Speaker" Property="Text" Value="&#xE74F;"/>
        <Setter TargetName="Speaker" Property="Foreground" Value="#FF9797"/>
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="#6EE7D0"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <TextBlock x:Name="Empty" Text="연결된 음원을 기다리고 있습니다." Foreground="#A9BCD6" Margin="0,10"/>
  <ItemsControl x:Name="List">
   <ItemsControl.ItemTemplate>
    <DataTemplate>
     <Border Background="#182232" CornerRadius="10" Padding="14,7" Margin="0,0,0,8">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="17" Foreground="#EDF3FF" Margin="0,0,10,0"/>
       <CheckBox Grid.Column="1" Style="{StaticResource MuteSwitch}" IsChecked="{Binding Muted,Mode=OneWay}" Checked="MuteChanged" Unchecked="MuteChanged"
                 AutomationProperties.Name="{Binding Name,StringFormat={}{0} 음소거}"/>
       <Button Grid.Column="2" Content="⋮" FontSize="24" Padding="0" Height="44" Width="44" Margin="0" Background="Transparent" Foreground="#EDF3FF" BorderThickness="0"
               Click="OpenMenu" AutomationProperties.Name="기기 설정" ToolTip="기기 설정"/>
      </Grid>
     </Border>
    </DataTemplate>
   </ItemsControl.ItemTemplate>
  </ItemsControl>
 </StackPanel>
</UserControl>
