<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SoundManager.Core\SoundManager.Core.csproj" />
    <ProjectReference Include="..\SoundManager.Server\SoundManager.Server.csproj" />
    <ProjectReference Include="..\SoundManager.Updates\SoundManager.Updates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="QRCoder" Version="1.7.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>../../assets/sound-manager.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="../../assets/sound-manager.ico" Link="Assets/SoundManager.ico" />
    <Content Include="../../assets/sound-manager.ico" Link="sound-manager.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../rust/target/release/sound-manager-server.exe" Link="sound-manager-server.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../rust/target/release/sound-manager-server.exe')" />
    <Content Include="../../rust/target/debug/sound-manager-server.exe" Link="sound-manager-server.exe" CopyToOutputDirectory="PreserveNewest" Condition="!Exists('../../rust/target/release/sound-manager-server.exe') And Exists('../../rust/target/debug/sound-manager-server.exe')" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="SoundManager.Windows.Tests" />
  </ItemGroup>

</Project>
