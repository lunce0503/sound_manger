{
  "manifest_version": 3,
  "name": "Sound Manager Tabs",
  "version": "0.4.0",
  "description": "선택한 Chrome·Edge 탭의 소리를 Sound Manager 서버에 독립된 음원으로 전송합니다.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["activeTab", "tabCapture", "offscreen", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "service-worker.js", "type": "module"},
  "action": {"default_popup": "popup.html", "default_title": "Sound Manager 탭 전송"},
  "content_security_policy": {"extension_pages":"script-src 'self'; object-src 'self'; connect-src http: https: ws: wss:"}
}
